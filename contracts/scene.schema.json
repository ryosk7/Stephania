{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "layers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "layers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "x",
          "y",
          "width",
          "height",
          "visible"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "source": {
            "enum": [
              "hdmi",
              "phone:rear",
              "phone:front"
            ]
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1919
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1079
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1920
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1080
          },
          "visible": {
            "type": "boolean"
          }
        }
      }
    }
  }
}