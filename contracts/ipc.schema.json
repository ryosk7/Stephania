{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stephania.invalid/contracts/ipc.schema.json",
  "title": "Stephania engine control IPC, version 1",
  "description": "Each frame is a 4-byte big-endian length followed by UTF-8 JSON (max 65536 bytes). See docs/IPC.md. Implemented by src/ipc.rs (server) and services/control/lib/engine_client.rb (client).",
  "$defs": {
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,64}$"
    },
    "method": {
      "enum": [
        "engine.status",
        "engine.capabilities",
        "stream.start",
        "stream.stop",
        "scene.validate",
        "scene.apply",
        "audio.status",
        "audio.configure"
      ]
    },
    "error_code": {
      "enum": [
        "invalid_frame",
        "frame_too_large",
        "invalid_request",
        "unsupported_version",
        "unknown_method",
        "invalid_params",
        "invalid_scene",
        "not_implemented",
        "engine_start_failed",
        "busy",
        "forbidden",
        "program_inactive",
        "program_timeout"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "method"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "params": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        }
      }
    },
    "ok_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "ok",
        "result"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/request_id"
        },
        "ok": {
          "const": true
        },
        "result": {
          "type": "object"
        }
      }
    },
    "error_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "ok",
        "error"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "request_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/request_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/error_code"
            },
            "message": {
              "type": "string"
            }
          }
        }
      }
    },
    "engine_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "uptime_ms",
        "state",
        "streaming_requested",
        "native_worker_running",
        "youtube_ingest_confirmed",
        "restart_attempts",
        "last_error",
        "native_worker_started_unix_ms",
        "program",
        "sources"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "Random per engine process; a change means the engine restarted."
        },
        "uptime_ms": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "idle",
            "starting_or_retrying",
            "native_worker_active",
            "stopping"
          ]
        },
        "streaming_requested": {
          "type": "boolean"
        },
        "native_worker_running": {
          "type": "boolean",
          "description": "Worker activity only; not evidence of ingest."
        },
        "youtube_ingest_confirmed": {
          "const": false
        },
        "restart_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "last_error": {
          "type": "string"
        },
        "native_worker_started_unix_ms": {
          "description": "Unix time in milliseconds the running native worker started (elapsed on-air time in the apps); null while none runs. Worker activity only, not evidence of ingest.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "program": {
          "description": "Stored scene on air, or null when none was applied in this engine process (HDMI passthrough default).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scene_id",
                "revision"
              ],
              "properties": {
                "scene_id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "sources": {
          "description": "Non-HDMI sources seen by the compositor (phone tracks), newest frame each.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "width",
              "height",
              "age_ms",
              "fresh",
              "mean_luma"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "age_ms": {
                "type": "integer",
                "minimum": 0
              },
              "fresh": {
                "type": "boolean",
                "description": "Young enough (500 ms) to be composed; stale sources fall back to the layer background."
              },
              "mean_luma": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      }
    },
    "audio_status": {
      "description": "audio.status result (docs/AUDIO.md). levels/master only while running.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "running",
        "inputs",
        "resyncs",
        "limited_blocks"
      ],
      "properties": {
        "running": {
          "type": "boolean"
        },
        "resyncs": {
          "type": "integer",
          "minimum": 0
        },
        "limited_blocks": {
          "type": "integer",
          "minimum": 0
        },
        "master": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peak_dbfs",
            "rms_dbfs",
            "clipped"
          ],
          "properties": {
            "peak_dbfs": {
              "type": "number",
              "maximum": 0
            },
            "rms_dbfs": {
              "type": "number",
              "maximum": 0
            },
            "clipped": {
              "type": "boolean"
            }
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "enabled",
              "device",
              "channels",
              "gain_db",
              "muted",
              "state"
            ],
            "properties": {
              "id": {
                "enum": [
                  "hdmi",
                  "mic"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "device": {
                "type": "string",
                "maxLength": 96
              },
              "channels": {
                "enum": [
                  1,
                  2
                ]
              },
              "gain_db": {
                "type": "number",
                "minimum": -60,
                "maximum": 12
              },
              "muted": {
                "type": "boolean"
              },
              "state": {
                "enum": [
                  "disabled",
                  "idle",
                  "waiting",
                  "active",
                  "stalled",
                  "error"
                ]
              },
              "error": {
                "type": "string"
              },
              "levels": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "peak_dbfs",
                  "rms_dbfs",
                  "clipped"
                ],
                "properties": {
                  "peak_dbfs": {
                    "type": "number",
                    "maximum": 0
                  },
                  "rms_dbfs": {
                    "type": "number",
                    "maximum": 0
                  },
                  "clipped": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "stream_start_params": {
      "description": "stream.start params (none, {} or {output}). output is the RTMPS destination including the stream key, sent by the control plane from its stored setting (PUT /api/v1/output); without it the engine uses STEPHANIA_OUTPUT. Secret: the engine never logs, reports or echoes it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": {
          "type": "string",
          "pattern": "^rtmps://[A-Za-z0-9.-]+(:[0-9]{1,5})?/[^/?#@%\\\\]{1,128}/[^/?#@%\\\\]{1,256}$"
        }
      }
    },
    "audio_configure_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "enum": [
                  "hdmi",
                  "mic"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "device": {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[A-Za-z0-9,:=._-]*$"
              },
              "channels": {
                "enum": [
                  1,
                  2
                ]
              },
              "gain_db": {
                "type": "number",
                "minimum": -60,
                "maximum": 12
              },
              "muted": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "transition": {
      "description": "scene.apply params.transition (optional; default cut). The ack names the first frame showing any of the new Program.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "cut"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "duration_ms"
          ],
          "properties": {
            "type": {
              "const": "fade"
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
            }
          }
        }
      ]
    },
    "scene_apply_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene",
        "scene_id",
        "revision"
      ],
      "properties": {
        "scene": {
          "$ref": "scene.schema.json"
        },
        "scene_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "transition": {
          "$ref": "#/$defs/transition"
        }
      },
      "description": "Image assets are loaded from STEPHANIA_ASSETS_DIR/<id>.png (hash-checked); a missing one fails with invalid_scene (asset_unavailable) and Program is unchanged."
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/ok_response"
    },
    {
      "$ref": "#/$defs/error_response"
    }
  ]
}
