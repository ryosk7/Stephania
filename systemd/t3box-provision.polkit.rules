// Install as /etc/polkit-1/rules.d/50-t3box-provision.rules
// Lets the provisioning service scan and join Wi-Fi via NetworkManager
// without root. Scope is limited to the t3box-provision user.
polkit.addRule(function(action, subject) {
    if (subject.user !== "t3box-provision") return polkit.Result.NOT_HANDLED;
    var allowed = [
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.wifi.scan",
        "org.freedesktop.NetworkManager.enable-disable-wifi"
    ];
    return allowed.indexOf(action.id) >= 0 ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
});
