[Unit]
Description=Stephania maintenance windows and SSH certificates (docs/MAINTENANCE.md)
After=stephania-pki.service

[Service]
Type=simple
User=stephania-maint
Group=stephania-maint
ExecStart=/usr/local/bin/stephania-maint
Environment=STEPHANIA_MAINT_DIR=/var/lib/stephania/maint
Environment=STEPHANIA_MAINT_SOCKET=/run/stephania-maint/maint.sock
Environment=STEPHANIA_PKI_DIR=/var/lib/stephania/pki
# The control plane (stephania-control, uid 852) for windows and certificates;
# the provisioning core (stephania-provision, uid 853) for otp.rotate only.
Environment=STEPHANIA_IPC_ALLOWED_UIDS=852
Environment=STEPHANIA_MAINT_ENROLL_UIDS=853
# steph's broker: the maint login user (uid and group 857) and root.
Environment=STEPHANIA_MAINT_OPS_SOCKET=/run/stephania-maint/ops.sock
Environment=STEPHANIA_MAINT_OPS_UIDS=857
Environment=STEPHANIA_MAINT_OPS_GID=857
# Engine status for the on-air check (the engine allows uid 856).
Environment=STEPHANIA_ENGINE_SOCKET=/run/stephania/engine.sock
Environment=STEPHANIA_MAINT_INBOX=/var/lib/stephania/inbox
ReadWritePaths=/var/lib/stephania/maint /var/lib/stephania/inbox
RuntimeDirectory=stephania-maint
# 0751: maint.sock (0660, group stephania-maint: control and provision)
# and ops.sock (0660, group maint) are each reachable only by their group.
RuntimeDirectoryMode=0751
Restart=on-failure
RestartSec=3
# systemctl (sshd, steph's restarts, reboot) goes through polkit
# (stephania-maint.polkit.rules) and RAUC through D-Bus
# (stephania-maint-rauc.dbus.conf), so no privileges are needed here.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
MemoryMax=32M
CPUWeight=20

[Install]
WantedBy=multi-user.target
