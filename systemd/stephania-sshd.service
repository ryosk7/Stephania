[Unit]
Description=Stephania maintenance SSH (only while a window is open)
# Not enabled: stephania-maint starts it for a window and stops it when
# the window closes, which also ends every session it started.
After=network.target stephania-maint.service
ConditionPathExists=/var/lib/stephania/maint/ssh_host_ed25519_key-cert.pub

[Service]
Type=notify
ExecStartPre=/usr/sbin/sshd -t -f /etc/stephania/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/stephania/sshd_config
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
KillMode=control-group
Restart=no
