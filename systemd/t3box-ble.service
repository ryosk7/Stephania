[Unit]
Description=T3Box BLE provisioning adapter (BlueZ GATT)
# Restarted together with bluetoothd so the GATT application and
# advertisement are always re-registered against a fresh daemon.
BindsTo=bluetooth.service
After=bluetooth.service t3box-provision.service
Wants=t3box-provision.service
PartOf=bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=t3box-ble
Group=t3box-ble
# bluetooth: BlueZ D-Bus access (see t3box-ble.dbus.conf);
# t3box-provision: reach /run/t3box-provision/provisioning.sock
SupplementaryGroups=bluetooth t3box-provision
ExecStart=/usr/local/bin/t3box-ble
Environment=T3BOX_PROVISION_SOCKET=/run/t3box-provision/provisioning.sock
# auto = prefer an external USB controller over the on-board CYW43455.
Environment=T3BOX_BLE_ADAPTER=auto
# The adapter exits on bluetoothd/adapter loss; always come back.
Restart=always
RestartSec=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryMax=48M
CPUWeight=20

[Install]
WantedBy=multi-user.target
