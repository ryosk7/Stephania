[Unit]
Description=T3Box device PKI (LAN TLS certificate)
# Re-run by t3box-pki.timer; restarts the control plane only when a new
# certificate was issued (exit 10).
Before=t3box-control.service
After=network.target

[Service]
Type=oneshot
Environment=T3BOX_PKI_DIR=/var/lib/t3box/pki
ExecStart=/bin/sh -c '/usr/local/bin/t3box-pki ensure --key-group t3box-control; rc=$?; if [ "$rc" = 10 ]; then systemctl --no-block try-restart t3box-control.service; exit 0; fi; exit "$rc"'
StateDirectory=t3box/pki
StateDirectoryMode=0755
UMask=0022
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# getifaddrs needs netlink; no sockets are opened otherwise.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN
