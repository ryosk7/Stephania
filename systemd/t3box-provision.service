[Unit]
Description=T3Box BLE/Wi-Fi provisioning core
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=t3box-provision
Group=t3box-provision
ExecStart=/usr/local/bin/t3box-provision
# Reference OS paths; the Buildroot target uses /data/t3box/credentials.
Environment=T3BOX_CREDENTIALS_DIR=/var/lib/t3box/credentials
Environment=T3BOX_PROVISION_SOCKET=/run/t3box-provision/provisioning.sock
Environment=T3BOX_PROVISION_RUNTIME=/run/t3box-provision/secrets
Environment=T3BOX_NETWORK_BACKEND=nm
# First-boot setup file on the selector partition (the FAT32 partition the
# user sees first; tools/setup-page, docs/INSTALL.md).
Environment=T3BOX_SETUP_FILE=/boot/selector/t3box-setup.txt
ReadWritePaths=-/boot/selector
# LAN enrollment (management.enroll): reads the endpoint published by
# t3box-pki and stores issued token hashes for the control plane. The
# tokens directory is setgid t3box-control (t3box.tmpfiles.conf).
Environment=T3BOX_PKI_DIR=/var/lib/t3box/pki
Environment=T3BOX_MANAGEMENT_TOKENS=/var/lib/t3box/tokens/tokens.json
ReadWritePaths=/var/lib/t3box/tokens
# Only the BLE adapter (t3box-ble, uid 854 in t3box.sysusers.conf) may use
# the socket besides root.
Environment=T3BOX_IPC_ALLOWED_UIDS=854
StateDirectory=t3box/credentials
StateDirectoryMode=0700
RuntimeDirectory=t3box-provision
# 0750 + group t3box-provision lets t3box-ble reach the 0660 socket.
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
MemoryMax=64M
CPUWeight=20

[Install]
WantedBy=multi-user.target
