// Install as /etc/polkit-1/rules.d/50-stephania-maint.rules
// What stephania-maint may ask systemd and logind for (docs/MAINTENANCE.md):
// start and stop the maintenance sshd for a window, restart the units in
// steph's allowlist, and reboot (also into a trial slot after an update).
// Nothing else.
polkit.addRule(function(action, subject) {
    if (subject.user !== "stephania-maint") return polkit.Result.NOT_HANDLED;
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit"), verb = action.lookup("verb");
        if (unit === "stephania-sshd.service" && (verb === "start" || verb === "stop")) return polkit.Result.YES;
        var restartable = ["stephania.service", "stephania-phone.service", "stephania-control.service",
                           "stephania-ble.service", "stephania-provision.service", "stephania-pki.service"];
        if (verb === "restart" && restartable.indexOf(unit) >= 0) return polkit.Result.YES;
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.login1.reboot" ||
        action.id === "org.freedesktop.login1.reboot-multiple-sessions" ||
        action.id === "org.freedesktop.login1.set-reboot-parameter") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
