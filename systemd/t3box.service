[Unit]
Description=T3Box Raspberry Pi diagnostics controller
After=network.target

[Service]
Type=simple
User=t3box
Group=t3box
ExecStart=/usr/local/bin/t3box
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
