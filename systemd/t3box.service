[Unit]
Description=T3Box Raspberry Pi media engine
After=network.target

[Service]
Type=simple
User=t3box
Group=t3box
ExecStart=/usr/local/bin/t3box
Environment=T3BOX_ENGINE_SOCKET=/run/t3box/engine.sock
# Control service uid (see t3box.sysusers.conf); root and t3box are implicit.
Environment=T3BOX_IPC_ALLOWED_UIDS=852
# Control socket directory; only the t3box group (control service) may enter.
RuntimeDirectory=t3box
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
