# Partition layout shared by the image build and the installer (MiB).
# docs/MASTER-ARCHITECTURE.md §8; numbers are provisional until proven on a Pi.
# GPT: 1 selector, 2 boot-a, 3 boot-b, 4 rootfs-a, 5 rootfs-b, 6 data.
STEPHANIA_SELECTOR_MIB=64
STEPHANIA_BOOT_MIB=256
STEPHANIA_ROOT_MIB=1024
STEPHANIA_DATA_MIN_MIB=512
