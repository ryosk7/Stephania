#!/bin/sh
# init= wrapper: read-only SquashFS root with a tmpfs overlay, so the OS
# never writes to the root partition (docs/MASTER-ARCHITECTURE.md §8).
# Persistent state is on /data (fstab). Exec's systemd as PID 1.
# mount -n: the read-only root has no writable mount table yet.
set -e
mount -n -t tmpfs -o mode=0755 t3box-overlay /overlay
mkdir -p /overlay/upper /overlay/work /overlay/root
mount -n -t overlay overlay -o lowerdir=/,upperdir=/overlay/upper,workdir=/overlay/work /overlay/root
for m in dev proc sys run; do
  if mountpoint -q "/$m"; then mount -n --move "/$m" "/overlay/root/$m"; fi
done
mkdir -p /overlay/root/media/rofs
cd /overlay/root
pivot_root . media/rofs
exec chroot . /sbin/init "$@" <dev/console >dev/console 2>&1
