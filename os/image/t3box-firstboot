#!/bin/sh
# First boot on the data partition: bootstrap control token (loopback only),
# directory skeleton. Idempotent.
set -eu
install -d -m 0755 /data/t3box/config /data/t3box/update /data/t3box/rauc
if [ ! -s /data/t3box/config/control.env ]; then
  umask 077
  printf 'T3BOX_CONTROL_TOKEN=%s\n' "$(openssl rand -hex 32)" >/data/t3box/config/control.env.new
  mv /data/t3box/config/control.env.new /data/t3box/config/control.env
fi
