[Unit]
Description=T3Box image smoke test (only with t3box.smoke=1)
ConditionKernelCommandLine=t3box.smoke=1
After=multi-user.target
SuccessAction=poweroff-force
FailureAction=poweroff-force

[Service]
Type=oneshot
ExecStart=/usr/local/lib/t3box/t3box-qemu-smoke
StandardOutput=journal+console
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
