#!/bin/sh
# Per-device host name t3box-<4 hex>, chosen once and kept on /data, so two
# boxes on one network never fight over t3box.local (mDNS) and the device
# certificate (t3box-pki) names a stable host. Runs every boot because the
# root overlay is not persistent.
set -eu
f=/data/t3box/config/hostname
install -d -m 0755 /data/t3box/config
if ! grep -qE '^t3box-[0-9a-f]{4}$' "$f" 2>/dev/null; then
  printf 't3box-%s\n' "$(openssl rand -hex 2)" >"$f.new" && mv "$f.new" "$f"
fi
name=$(cat "$f")
echo "$name" >/etc/hostname
hostname "$name"
