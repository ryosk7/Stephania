#!/bin/sh
# Image smoke test, run only when the kernel command line asks for it
# (stephania.smoke=1 → stephania-qemu-smoke.service; ci/qemu-smoke.sh).
# Prints SMOKE PASS/FAIL lines and a final SMOKE RESULT to the console.
fails=0
ok() { echo "SMOKE PASS $*"; }
bad() { echo "SMOKE FAIL $*"; fails=$((fails + 1)); }
info() { echo "SMOKE INFO $*"; }
check() { msg=$1; shift; if "$@" >/dev/null 2>&1; then ok "$msg"; else bad "$msg"; fi; }

# This unit is itself part of boot, so wait for every other start job
# instead of `is-system-running --wait` (which would wait on us).
for i in $(seq 300); do
  [ -z "$(systemctl list-jobs --no-legend | grep -v stephania-qemu-smoke)" ] && break
  sleep 1
done
info "system state $(systemctl is-system-running)"
info "version $(cat /etc/stephania-version)"
check "root is an overlay over a read-only SquashFS" sh -c 'findmnt -n -o FSTYPE / | grep -qx overlay && findmnt -n -o FSTYPE,OPTIONS /media/rofs | grep -q "^squashfs .*ro"'
check "read-only root cannot be written" sh -c '! touch /media/rofs/.stephania-write-test'
check "data partition mounted (ext4)" sh -c 'findmnt -n -o FSTYPE /data | grep -qx ext4'
check "state bind-mounted from data" sh -c 'findmnt -n /var/lib/stephania'
check "first-boot token created on data" test -s /data/stephania/config/control.env
check "licence files of shipped packages are kept" sh -c 'test -s /usr/share/doc/libx264-164/copyright && test -s /usr/share/doc/libavcodec61/copyright'
check "no compiler in the image" sh -c '! command -v gcc && ! command -v cc && ! command -v make'
for u in stephania stephania-control stephania-firstboot stephania-phone; do check "$u active" systemctl is-active "$u"; done
info "stephania-provision $(systemctl is-active stephania-provision) (no Wi-Fi device in QEMU)"
STEPHANIA_CONTROL_TOKEN=
[ -r /data/stephania/config/control.env ] && . /data/stephania/config/control.env
# Ruby boot is slow under QEMU TCG: wait for Puma to listen.
for i in $(seq 240); do curl -s -o /dev/null http://127.0.0.1:9292/ 2>/dev/null && break; sleep 1; done
check "control API answers on loopback with the bootstrap token" \
  curl -fsS -H "Authorization: Bearer $STEPHANIA_CONTROL_TOKEN" http://127.0.0.1:9292/api/v1/capabilities
check "control reaches the engine over IPC" \
  curl -fsS -H "Authorization: Bearer $STEPHANIA_CONTROL_TOKEN" http://127.0.0.1:9292/api/v1/status
check "Studio is served by the control plane" sh -c 'curl -fsS http://127.0.0.1:9292/ | grep -q "<div id=\"root\""'
check "phone service answers through the control plane" sh -c "curl -fsS -H 'Authorization: Bearer $STEPHANIA_CONTROL_TOKEN' http://127.0.0.1:9292/api/v1/cameras/session | grep -q '\"state\":\"none\"'"
check "engine ingest socket for phone media exists" test -S /run/stephania/media.sock
check "engine health via stephania-bootctl" env STEPHANIA_HEALTH_ATTEMPTS=30 /usr/local/bin/stephania-bootctl health
check "device PKI published an endpoint" test -s /var/lib/stephania/pki/endpoint.json
check "device CA served at /ca.pem" sh -c "curl -fsS --cacert /var/lib/stephania/pki/ca.pem --resolve $(hostname).local:9443:127.0.0.1 https://$(hostname).local:9443/ca.pem | cmp -s - /var/lib/stephania/pki/ca.pem"
host=$(hostname)
check "per-device host name kept on data" sh -c "echo '$host' | grep -qE '^stephania-[0-9a-f]{4}$' && grep -qx '$host' /data/stephania/config/hostname"
check "device certificate names the host" grep -q "\"host\":\"$host.local\"" /var/lib/stephania/pki/endpoint.json
check "avahi-daemon active" systemctl is-active avahi-daemon
# Maintenance SSH (docs/MAINTENANCE.md): nothing listens on 22 until a window
# opens; a window opened with a code lets maint log in by certificate only.
check "stephania-maint active" systemctl is-active stephania-maint
check "maintenance CAs created on data" test -s /var/lib/stephania/maint/user_ca.pub
check "no maintenance sshd without a window" sh -c '! systemctl is-active -q stephania-sshd && ! ss -Hltn "sport = :22" | grep -q .'
check "Debian ssh units masked" sh -c '[ "$(systemctl is-enabled ssh.service 2>&1)" = masked ]'
check "nftables limits SSH to LAN sources" sh -c 'nft list table inet stephania | grep -q "tcp dport 22 drop"'
maint_rpc() {
  ruby -rjson -rsocket -e 's = UNIXSocket.new("/run/stephania-maint/maint.sock"); b = {version: 1, request_id: "smoke", method: ARGV[0], params: JSON.parse(ARGV[1])}.to_json
    s.write([b.bytesize].pack("N") + b); n = s.read(4).unpack1("N"); r = JSON.parse(s.read(n)); puts(r["ok"] ? r["result"].to_json : {error: r["error"]["code"]}.to_json)' "$1" "$2"
}
maint_code=$(ruby -rjson -ropenssl -e 'k = [JSON.parse(File.read("/var/lib/stephania/maint/state.json"))["otp_secret"]].pack("H*")
  m = OpenSSL::HMAC.digest("SHA1", k, [Time.now.to_i / 30].pack("Q>")); o = m.bytes[19] & 15
  printf("%06d", (m[o, 4].unpack1("N") & 0x7fffffff) % 1_000_000)')
win=$(maint_rpc window.open "{\"actor\":\"smoke\",\"client_addr\":\"127.0.0.1\",\"code\":\"$maint_code\"}" | ruby -rjson -e 'puts JSON.parse($stdin.read)["window_id"].to_s')
if [ -n "$win" ]; then ok "maintenance window opened with a code"; else bad "maintenance window: $(journalctl -b -u stephania-maint -n 5 --no-pager | tr '\n' ' ')"; fi
for i in $(seq 20); do systemctl is-active -q stephania-sshd && break; sleep 1; done
check "maintenance sshd started for the window (polkit rule)" systemctl is-active stephania-sshd
mk=$(mktemp -d)
ssh-keygen -q -t ed25519 -N '' -f "$mk/id"
maint_rpc cert.sign "{\"window_id\":\"$win\",\"public_key\":\"$(cat "$mk/id.pub")\",\"client_addr\":\"127.0.0.1\"}" >"$mk/sign.json"
ruby -rjson -e 'r = JSON.parse(File.read(ARGV[0])); File.write(ARGV[1], r["certificate"].to_s + "\n"); File.write(ARGV[2], "@cert-authority " + ARGV[3] + " " + r["host_ca"].to_s + "\n")' \
  "$mk/sign.json" "$mk/id-cert.pub" "$mk/known_hosts" "$host.local"
ssh_maint() { ssh -F none -o BatchMode=yes -o IdentitiesOnly=yes -o IdentityFile="$mk/id" -o CertificateFile="$mk/id-cert.pub" \
  -o UserKnownHostsFile="$mk/known_hosts" -o StrictHostKeyChecking=yes -o HostKeyAlias="$host.local" -o ConnectTimeout=10 "$1@127.0.0.1" "$2"; }
login_user=$(ssh_maint maint 'id -un' 2>/dev/null)
if [ "$login_user" = maint ]; then ok "maint logs in with a 5-minute certificate (host certificate verified)"; else bad "maint login ($login_user)"; fi
if ssh_maint root true >/dev/null 2>&1; then bad "a maint certificate logged in as root"; else ok "a maint certificate cannot log in as root"; fi
# steph inside the session: the certificate's account and window, and the device's own state.
who=$(ssh_maint maint 'steph whoami --json' 2>/dev/null | ruby -rjson -e 'w = JSON.parse($stdin.read); puts [w["account"], w["window_id"], w["level"]].join(" ")' 2>/dev/null)
if [ "$who" = "smoke $win maint" ]; then ok "steph whoami reads the session certificate (account, window)"; else bad "steph whoami ($who)"; fi
st=$(ssh_maint maint 'steph status --json' 2>/dev/null | ruby -rjson -e 's = JSON.parse($stdin.read); puts [s["engine"], s["version"]["stephania"].to_s.empty? ? "noversion" : "version", s["failed_units"].size].join(" ")' 2>/dev/null)
if [ "${st%% *}" = active ] && echo "$st" | grep -q " version "; then ok "steph status as maint: engine active, version ($st)"; else bad "steph status ($st)"; fi
if ssh_maint maint 'steph logs engine -n 5' 2>/dev/null | grep -q .; then ok "steph logs engine (maint reads the journal)"; else bad "steph logs engine"; fi
if ssh_maint maint 'steph diag -o -' 2>/dev/null | tar -tzf - 2>/dev/null | grep -q '/status.json$'; then ok "steph diag -o - streams an evidence bundle"; else bad "steph diag"; fi
# steph's changes through the broker (ops.sock, polkit): an allowlisted
# restart, a refused unit, and closing the window from inside.
before=$(systemctl show -p InvocationID --value stephania-pki.service)
if ssh_maint maint 'steph restart pki' >/dev/null 2>&1 && [ "$(systemctl show -p InvocationID --value stephania-pki.service)" != "$before" ]; then ok "steph restart pki as maint (broker, polkit)"; else bad "steph restart pki: $(journalctl -b -u stephania-maint -n 3 --no-pager | tr '\n' ' ')"; fi
ssh_maint maint 'steph restart sshd' >/dev/null 2>&1; rc=$?
if [ "$rc" = 4 ]; then ok "steph refuses units outside its allowlist"; else bad "steph allowlist (exit $rc)"; fi
journalctl -b -u stephania-maint --no-pager | grep '"maintenance.ops_restart"' | grep -q '"actor":"smoke@' && ok "broker audit names the session" || bad "broker audit"
ssh_maint maint 'steph window close' >/dev/null 2>&1
for i in $(seq 20); do systemctl is-active -q stephania-sshd || break; sleep 1; done
check "steph window close stops the maintenance sshd" sh -c '! systemctl is-active -q stephania-sshd'
maint_rpc window.close '{"actor":"smoke"}' >/dev/null
for i in $(seq 20); do systemctl is-active -q stephania-sshd || break; sleep 1; done
check "maintenance sshd stopped with the window" sh -c '! systemctl is-active -q stephania-sshd'
rm -rf "$mk"
# DNS-SD: the management service is browsable with its port.
for i in $(seq 30); do avahi-browse -rpt _stephania._tcp 2>/dev/null | grep -q '^=.*;9443;' && break; sleep 1; done
check "mDNS publishes _stephania._tcp on 9443" sh -c "avahi-browse -rpt _stephania._tcp | grep -q '^=.*;9443;'"
check "mDNS resolves the host name" avahi-resolve -4 -n "$host.local"
code=$(curl -s -o /dev/null -w '%{http_code}' --cacert /var/lib/stephania/pki/ca.pem --resolve "$host.local:9443:127.0.0.1" "https://$host.local:9443/api/v1/capabilities")
[ "$code" = 401 ] && ok "LAN TLS listener verifies against the device CA and requires an issued token" || bad "LAN TLS listener ($code)"
info "rauc: $(rauc status 2>&1 | head -3 | tr '\n' ' ')"
if [ "$fails" != 0 ]; then
  info "control: $(systemctl show -p ActiveState,SubState,NRestarts stephania-control | tr '\n' ' ')"
  journalctl -b -u stephania-control -n 40 --no-pager | sed 's/^/SMOKE INFO control-log /'
fi
for u in $(systemctl --failed --no-legend --plain | awk '{print $1}'); do info "failed unit $u: $(journalctl -b -u "$u" -n 5 --no-pager | tail -5 | tr '\n' ' ')"; done
if [ "$fails" = 0 ]; then echo "SMOKE RESULT PASS"; else echo "SMOKE RESULT FAIL ($fails)"; fi
