#!/bin/sh
# Stephania RAM installer (docs/INSTALL.md). Runs as /init of installer.cpio.gz
# after the firmware booted it from the FAT32 card the user copied the
# release ZIP onto. Turns that card — and only that card — into the A/B
# layout of os/layout.env.
#
# Stages (state in <selector>/stephania-install/state once the card is ours):
#   verify     signature, file hashes, target identity, capacity, RAM (no writes)
#   partition  GPT + selector with the installer files    (destructive)
#   staged     payload copied to the data partition       (resumable from here)
#   written    boot-a / rootfs-a written and read back
#   done       selector holds only autoboot.txt; data skeleton ready
# stephania.install_fail_at=<stage> (tests) cuts power right after that stage.
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
. /etc/stephania/layout.env

log() { echo "STEPHANIA-INSTALL $*" >/dev/console 2>/dev/null || echo "STEPHANIA-INSTALL $*"; [ -n "${LOGFILE:-}" ] && echo "$*" >>"$LOGFILE"; }
fatal() { log "FAIL $*"; halt_now; }
halt_now() {
  sync
  if grep -qw stephania.install_poweroff=1 /proc/cmdline; then poweroff -f; fi
  log "halted; power off the device"
  while :; do sleep 3600; done
}
cmdline_value() { tr ' ' '\n' </proc/cmdline | sed -n "s/^$1=//p" | tail -1; }
power_cut_after() {
  if [ "$(cmdline_value stephania.install_fail_at)" = "$1" ]; then
    log "TEST power cut after stage $1"
    # Let the serial console drain the line first: sysrq raises the console
    # log level for its own message, which would otherwise land inside it.
    # Nothing is synced, so the disks still see an unclean cut.
    sleep 1
    echo o >/proc/sysrq-trigger   # immediate, no sync: like pulling the plug
  fi
}

mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /run /mnt/src /mnt/sel /mnt/data /run/payload /tmp
mount -t tmpfs -o size=90% tmpfs /run
mount -t tmpfs tmpfs /tmp
mkdir -p /run/payload /run/boot
echo 1 >/proc/sys/kernel/sysrq
# Kernel messages below KERN_ALERT stay off the console, so they cannot
# split the installer's own lines ("TE[ 5.69] sysrq: Power Off ST power cut").
echo 1 >/proc/sys/kernel/printk
for m in $(cat /etc/stephania/modules 2>/dev/null); do modprobe "$m" 2>/tmp/modprobe.err || log "module $m: $(cat /tmp/modprobe.err)"; done

INSTALL_ID=$(cmdline_value stephania.install_id)
[ -n "$INSTALL_ID" ] || fatal "no stephania.install_id on the kernel command line"
log "installer $(cat /etc/stephania/version) install_id=$INSTALL_ID"

# Wait for block devices (no udev here).
i=0; while [ $i -lt 50 ] && [ -z "$(ls /sys/block | grep -E '^(vd|sd|mmcblk|nvme)' )" ]; do sleep 0.2; i=$((i+1)); done

part() { # disk partition-number -> device node
  case $1 in *[0-9]) echo "/dev/${1}p$2" ;; *) echo "/dev/$1$2" ;; esac
}

verify_manifest() { # dir -> 0 if manifest is signed by the release key and matches INSTALL_ID
  [ -f "$1/manifest.json" ] && [ -f "$1/manifest.sig" ] || return 1
  openssl pkeyutl -verify -pubin -inkey /etc/stephania/install.pub -rawin -in "$1/manifest.json" -sigfile "$1/manifest.sig" >/dev/null 2>&1 || return 1
  grep -q "\"install_id\": *\"$INSTALL_ID\"" "$1/manifest.json"
}

manifest_field() { # file key -> value (flat JSON written by os/installer/build.sh)
  sed -n "s/.*\"$2\": *\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" "$1" | head -1
}

# Candidate media: a fresh card (partition 1 = FAT with our signed manifest)
# or one we already partitioned (GPT selector with our state file).
fresh=""; resume=""
log "block devices: $(ls /sys/block | tr '\n' ' ')"
for d in $(ls /sys/block | grep -E '^(vd[a-z]+|sd[a-z]+|mmcblk[0-9]+|nvme[0-9]+n[0-9]+)$'); do
  p1=$(part "$d" 1)
  [ -b "$p1" ] || { log "$d: no partition 1"; continue; }
  if mount -t vfat -o ro "$p1" /mnt/src 2>/tmp/mount.err; then
    if [ -f /mnt/src/stephania-install/state ] && grep -qx "install_id=$INSTALL_ID" /mnt/src/stephania-install/state; then
      resume="$resume $d"
    elif verify_manifest /mnt/src/stephania-install; then
      fresh="$fresh $d"
    else
      log "$d: no manifest for this install_id signed by the release key"
    fi
    umount /mnt/src
  else
    log "$d: partition 1 is not FAT ($(cat /tmp/mount.err))"
  fi
done
n=$(echo $fresh $resume | wc -w)
[ "$n" -eq 1 ] || fatal "expected exactly one Stephania install medium, found $n (fresh:${fresh:- none} resume:${resume:- none}); nothing was written"
DISK=$(echo $fresh $resume | tr -d ' ')
DEV=/dev/$DISK
log "target $DEV ($( [ -n "$fresh" ] && echo fresh || echo resume))"

state_of() { sed -n 's/^stage=//p' /mnt/sel/stephania-install/state 2>/dev/null; }
set_state() {
  printf 'install_id=%s\nstage=%s\n' "$INSTALL_ID" "$1" >/mnt/sel/stephania-install/state.new
  sync; mv /mnt/sel/stephania-install/state.new /mnt/sel/stephania-install/state; sync
  log "stage $1"
}

if [ -n "$fresh" ]; then
  # ---- verify (read-only) ---------------------------------------------
  mount -t vfat -o ro "$(part "$DISK" 1)" /mnt/src || fatal "cannot mount the install medium"
  M=/mnt/src/stephania-install
  verify_manifest "$M" || fatal "manifest signature invalid"
  for f in boot.vfat rootfs.squashfs; do
    want=$(manifest_field "$M/manifest.json" "${f}_sha256")
    [ -f "$M/$f" ] || fatal "missing $f"
    have=$(sha256sum "$M/$f" | cut -d' ' -f1)
    [ "$have" = "$want" ] || fatal "$f hash mismatch"
  done
  bytes=$(( $(cat /sys/block/$DISK/size) * 512 ))
  need=$(( (1 + STEPHANIA_SELECTOR_MIB + 2*STEPHANIA_BOOT_MIB + 2*STEPHANIA_ROOT_MIB + STEPHANIA_DATA_MIN_MIB + 1) * 1048576 ))
  [ "$bytes" -ge "$need" ] || fatal "card too small: $bytes bytes, need $need"
  [ "$(stat -c %s "$M/rootfs.squashfs")" -le $((STEPHANIA_ROOT_MIB * 1048576)) ] || fatal "rootfs larger than its partition"
  [ "$(stat -c %s "$M/boot.vfat")" -le $((STEPHANIA_BOOT_MIB * 1048576)) ] || fatal "boot image larger than its partition"
  avail=$(df -k /run | awk 'NR==2{print $4}')
  payload=$(( ($(stat -c %s "$M/rootfs.squashfs") + $(stat -c %s "$M/boot.vfat")) / 1024 + 65536 ))
  [ "$avail" -ge "$payload" ] || fatal "not enough RAM for the payload"
  # Everything the card must keep is copied to RAM before the first write.
  cp "$M/boot.vfat" "$M/rootfs.squashfs" "$M/manifest.json" "$M/manifest.sig" /run/payload/ || fatal "copy to RAM failed"
  (cd /mnt/src && find . -maxdepth 1 -type f -exec cp {} /run/boot/ \;)
  [ -d /mnt/src/overlays ] && cp -r /mnt/src/overlays /run/boot/
  umount /mnt/src
  ( cd /run/payload && sha256sum -c >/dev/null 2>&1 <<SUMS
$(manifest_field manifest.json boot.vfat_sha256)  boot.vfat
$(manifest_field manifest.json rootfs.squashfs_sha256)  rootfs.squashfs
SUMS
  ) || fatal "RAM copy does not match the manifest"
  log "stage verify"
  power_cut_after verify

  # ---- partition (destructive from here) -------------------------------
  sfdisk -q --wipe always "$DEV" <<GPT || fatal "partitioning failed"
label: gpt
size=${STEPHANIA_SELECTOR_MIB}MiB, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=selector
size=${STEPHANIA_BOOT_MIB}MiB, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=boot-a
size=${STEPHANIA_BOOT_MIB}MiB, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=boot-b
size=${STEPHANIA_ROOT_MIB}MiB, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name=rootfs-a
size=${STEPHANIA_ROOT_MIB}MiB, type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name=rootfs-b
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name=data
GPT
  blockdev --rereadpt "$DEV" 2>/dev/null; sleep 1
  mkfs.vfat -F 32 -n SELECTOR "$(part "$DISK" 1)" >/dev/null || fatal "mkfs selector failed"
  mount -t vfat "$(part "$DISK" 1)" /mnt/sel || fatal "cannot mount selector"
  # The selector boots the installer again until the install is done.
  cp -r /run/boot/. /mnt/sel/
  mkdir -p /mnt/sel/stephania-install
  cp /run/payload/manifest.json /run/payload/manifest.sig /mnt/sel/stephania-install/
  LOGFILE=/mnt/sel/stephania-install/install.log
  set_state partition
  power_cut_after partition
  # ---- staged -----------------------------------------------------------
  mkfs.ext4 -q -F -L data "$(part "$DISK" 6)" || fatal "mkfs data failed"
  mount -t ext4 "$(part "$DISK" 6)" /mnt/data || fatal "cannot mount data"
  mkdir -p /mnt/data/stephania-install
  cp /run/payload/boot.vfat /run/payload/rootfs.squashfs /run/payload/manifest.json /mnt/data/stephania-install/ || fatal "staging failed"
  sync
  set_state staged
  power_cut_after staged
else
  mount -t vfat "$(part "$DISK" 1)" /mnt/sel || fatal "cannot mount selector"
  LOGFILE=/mnt/sel/stephania-install/install.log
  log "resuming at stage $(state_of)"
  case $(state_of) in
    partition)
      fatal "RECOVERY: power was lost before the installation files were saved on the card. Format the card as FAT32, copy the ZIP contents again and power on." ;;
    staged|written) ;;
    done) log "already installed"; umount /mnt/sel; sync; halt_now ;;
    *) fatal "unknown install state" ;;
  esac
  mount -t ext4 "$(part "$DISK" 6)" /mnt/data || fatal "cannot mount data"
  verify_manifest /mnt/sel/stephania-install || fatal "manifest on the card is not signed"
  for f in boot.vfat rootfs.squashfs; do
    [ "$(sha256sum /mnt/data/stephania-install/$f | cut -d' ' -f1)" = "$(manifest_field /mnt/sel/stephania-install/manifest.json "${f}_sha256")" ] || fatal "RECOVERY: staged $f is damaged; copy the ZIP again"
  done
fi

# ---- written --------------------------------------------------------------
S=/mnt/data/stephania-install
if [ "$(state_of)" = staged ]; then
  for pair in "2 boot.vfat" "4 rootfs.squashfs"; do
    set -- $pair
    dd if="$S/$2" of="$(part "$DISK" "$1")" bs=4M conv=fsync 2>/dev/null || fatal "writing $2 failed"
    size=$(stat -c %s "$S/$2")
    back=$(head -c "$size" "$(part "$DISK" "$1")" | sha256sum | cut -d' ' -f1)
    [ "$back" = "$(manifest_field /mnt/sel/stephania-install/manifest.json "${2}_sha256")" ] || fatal "read-back of $2 does not match"
  done
  set_state written
  power_cut_after written
fi

# ---- done -----------------------------------------------------------------
mkdir -p /mnt/data/stephania/varlib /mnt/data/stephania/config /mnt/data/stephania/update /mnt/data/stephania/rauc
cp /mnt/sel/stephania-install/manifest.json /mnt/data/stephania/config/installed-manifest.json
rm -rf "$S"; sync
umount /mnt/data
# Selector: only the A/B switch (firmware tryboot) and the install record.
find /mnt/sel -mindepth 1 -maxdepth 1 ! -name stephania-install -exec rm -rf {} +
printf '[all]\ntryboot_a_b=1\nboot_partition=2\n[tryboot]\nboot_partition=3\n' >/mnt/sel/autoboot.txt
rm -f /mnt/sel/stephania-install/manifest.sig
set_state done
umount /mnt/sel; sync
log "RESULT PASS installed $(cat /etc/stephania/version) on $DEV"
if grep -qw stephania.install_poweroff=1 /proc/cmdline; then poweroff -f; fi
reboot -f
