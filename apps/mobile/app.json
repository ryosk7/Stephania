{
  "expo": {
    "name": "Stephania Connect",
    "slug": "stephania-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.ryosk7.stephania.connect",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Uses the local network to control a Stephania device on the same Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSAccessorySetupKitSupports": [
          "Bluetooth"
        ],
        "NSAccessorySetupBluetoothServices": [
          "7C3B0200-5D1E-4A6F-9B0E-3A1F2C4D5E60"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.ryosk7.stephania.connect"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f6f6f7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0b0b0c"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Uses the camera to send your camera picture to your Stephania device.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Uses Bluetooth to find and set up a nearby Stephania."
        }
      ]
    ],
    "scheme": "stephania-connect"
  }
}
