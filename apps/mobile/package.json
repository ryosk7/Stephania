  "devDependencies": {
    "@storybook/addon-ondevice-actions": "^10.7.3",
    "@storybook/react-native": "^10.7.3",
    "@storybook/react-native-web-vite": "^10.6.9",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "~19.3.0",
