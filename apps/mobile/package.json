    "storybook": "^10.6.9",
    "typescript": "~6.0.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts && tsc --noEmit",
    "test": "vitest run",
    "notices": "node scripts/notices.mjs",
    "check:notices": "node scripts/notices.mjs --check",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "storybook:web": "storybook dev -p 6006 -c .storybook",
    "build-storybook": "storybook build -c .storybook -o storybook-static",
    "check:stories": "node scripts/stories-smoke.mjs storybook-static storybook-shots"
  },
  "private": true
