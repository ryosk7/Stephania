{
  "name": "t3box-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "gen:api": "openapi-typescript ../../contracts/openapi.yaml -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../../contracts/openapi.yaml -o /tmp/t3box-schema.d.ts && diff -u src/api/schema.d.ts /tmp/t3box-schema.d.ts",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "^3.2.7"
  }
}
